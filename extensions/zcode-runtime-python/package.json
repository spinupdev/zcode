{
  "name": "zcode-runtime-python",
  "displayName": "ZCode Runtime Python",
  "description": "Run Python in the browser via Pyodide (no remote server)",
  "version": "0.1.0",
  "publisher": "spinupdev",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "extensionDependencies": ["spinupdev.zcode-runtime-core"],
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:zcode.runtime.python.repl",
    "onTerminalProfile:zcode.pyodide"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zcode.runtime.python.repl",
        "title": "ZCode: Open Python REPL (Pyodide)",
        "icon": "$(python)"
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "zcode.pyodide",
          "title": "Python (Pyodide)",
          "icon": "python"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"process.exit(0)\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  }
}
