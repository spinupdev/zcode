{
  "name": "zcode-runtime-node",
  "displayName": "ZCode Runtime Node / JS",
  "description": "Run JavaScript/TypeScript via WebContainers (multi-file + npm) or worker fallback",
  "version": "0.2.0",
  "publisher": "spinupdev",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "spinupdev.zcode-runtime-core"
  ],
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:zcode.runtime.node.npmInstall",
    "onCommand:zcode.runtime.node.npmRun",
    "onCommand:zcode.runtime.node.mountStatus"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zcode.runtime.node.npmInstall",
        "title": "ZCode: npm install (WebContainer)"
      },
      {
        "command": "zcode.runtime.node.npmRun",
        "title": "ZCode: npm run… (WebContainer)"
      },
      {
        "command": "zcode.runtime.node.mountStatus",
        "title": "ZCode: WebContainer Mount Preview"
      }
    ]
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"process.exit(0)\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@webcontainer/api": "1.6.1"
  }
}
